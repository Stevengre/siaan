#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$SCRIPT_DIR/issue-tui"

if [[ ! -x "$BIN" ]]; then
  echo "error: $BIN not found or not executable. Run: $SCRIPT_DIR/install.sh" >&2
  exit 1
fi

# macOS can kill unsigned/quarantined binaries from synced/project paths.
# Make launch resilient by clearing xattrs and ad-hoc signing every run.
xattr -dr com.apple.provenance "$BIN" 2>/dev/null || true
xattr -dr com.apple.quarantine "$BIN" 2>/dev/null || true
codesign --force --sign - "$BIN" >/dev/null 2>&1 || true

exec "$BIN" "$@"
